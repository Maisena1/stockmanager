generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EMPLOYEE
}

enum PaymentMethod {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
}

enum AuditAction {
  VENTA
  IMPORTACION
  ARTICULO_CREADO
  ARTICULO_ACTUALIZADO
  ARTICULO_ELIMINADO
  USUARIO_CREADO
  USUARIO_ACTUALIZADO
  USUARIO_DESHABILITADO
  CODIGO_RESETEADO
  PROVEEDOR_CREADO
  PROVEEDOR_ACTUALIZADO
  PROVEEDOR_ELIMINADO
}

model User {
  id        Int        @id @default(autoincrement())
  username  String     @unique
  code      String
  role      Role       @default(EMPLOYEE)
  active    Boolean    @default(true)
  phone     String?
  notes     String?
  sales     Sale[]
  auditLogs AuditLog[]
  turnos    Turno[]
  createdAt DateTime   @default(now())
}

model Supplier {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  phone     String?
  email     String?
  notes     String?
  createdAt DateTime  @default(now())
  articles  Article[]
}

model Article {
  code            String     @id
  name            String
  category        String
  motorcycleModel String
  purchasePrice   Float
  salePrice       Float
  stock           Int
  minStock        Int
  supplier        String
  supplierId      Int?
  barcode         String?    @unique
  photo           String?
  saleItems       SaleItem[]
  supplierInfo    Supplier?  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
}

model Sale {
  id            Int           @id @default(autoincrement())
  userId        Int
  total         Float
  paymentMethod PaymentMethod
  createdAt     DateTime      @default(now())
  items         SaleItem[]

  user User @relation(fields: [userId], references: [id])
}

model SaleItem {
  id          Int     @id @default(autoincrement())
  saleId      Int
  articleCode String?
  articleName String
  quantity    Int
  unitPrice   Float
  total       Float

  sale    Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  // Snapshot histórico: si el artículo se elimina, la línea de venta se
  // conserva con su nombre y articleCode queda en null.
  article Article? @relation(fields: [articleCode], references: [code], onDelete: SetNull)
}

model AuditLog {
  id        Int          @id @default(autoincrement())
  userId    Int
  action    AuditAction
  detail    String
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Turno {
  id        Int       @id @default(autoincrement())
  userId    Int
  abiertoAt DateTime  @default(now())
  cerradoAt DateTime?

  user User @relation(fields: [userId], references: [id])
}
